@layouts.master({title: 'Book a court'})

<div class="booking-stepper">
  <div class="step active">
    <div class="step-circle">1</div>
    <div class="step-label">Time slot</div>
  </div>
  <div class="step-line"></div>
  <div class="step">
    <div class="step-circle">2</div>
    <div class="step-label">Details</div>
  </div>
  <div class="step-line"></div>
  <div class="step">
    <div class="step-circle">3</div>
    <div class="step-label">Payment</div>
  </div>
</div>

<div
  class="booking-layout"
  id="booking-page"
  data-court-name="{{ court ? court.courtName : '' }}"
  data-court-price="{{ court ? court.pricePerHour : 0 }}"
  data-booked-slots='{{{ bookedSlotsJson || "[]" }}}'
>
  <div class="booking-main">
    <h2>เลือกช่วงเวลา</h2>

    <div class="court-info-card">
      <div class="court-info-text">
        <div class="court-info-name">{{ court ? court.courtName : '' }}</div>
        <div class="court-info-detail">{{ court ? '฿' + court.pricePerHour + '/hr' : '-' }}</div>
      </div>
    </div>

    <div class="booking-field">
      <label>วันที่เข้าใช้บริการ</label>
      <div class="date-carousel" id="date-carousel">
        <button type="button" class="date-carousel-arrow" id="date-prev">&#8249;</button>
        <div class="date-carousel-track" id="date-track"></div>
        <button type="button" class="date-carousel-arrow" id="date-next">&#8250;</button>
      </div>
      <input type="hidden" id="booking-date" value="{{ bookingDate || '' }}">
    </div>

{{--     <div class="booking-field">
      <label>เลือกสนาม</label>

      <select class="ui dropdown" id="court-select">
        <option value="">เลือกสนาม</option>

        @each(c in courts)
          <option
            value="{{ c.id }}"
            data-price="{{ c.pricePerHour }}"
            {{ court && court.id === c.id ? 'selected' : '' }}
          >
            {{ c.courtName }}
          </option>
        @end
      </select>
    </div> --}}

    <div class="booking-field">
      <label>เลือกสนาม</label>
      <div class="court-btn-group" id="court-btn-group">
        @each(c in courts)
          <button
            type="button"
            class="court-btn{{ court && court.id === c.id ? ' selected' : '' }}"
            data-court-id="{{ c.id }}"
            data-court-name="{{ c.courtName }}"
            data-price="{{ c.pricePerHour }}"
          >
            {{ c.courtName }}
          </button>
        @end
      </div>
      <input type="hidden" id="court-select" value="{{ court ? court.id : '' }}">
    </div>

    <div class="slot-status">
      เลือกแล้ว: <span id="selected-label">none</span> - เลือกได้สูงสุด 3 ช่วงเวลาติดต่อกัน
    </div>
    <div id="slot-grid" class="slot-grid"></div>

    <button class="continue-btn" id="continue-booking">ดำเนินการต่อ →</button>
  </div>

  <div class="booking-summary">
    <h3>รายละเอียดการจอง</h3>

    <div class="summary-row"><span>สนาม</span><span id="sum-court">-</span></div>
    <div class="summary-row"><span>วันที่</span><span id="sum-date">-</span></div>
    <div class="summary-row"><span>เวลา</span><span id="sum-time">-</span></div>
    <div class="summary-row"><span>ระยะเวลาการจอง</span><span id="sum-duration">-</span></div>
    <div class="summary-row"><span>ค่าบริการสนาม</span><span id="sum-fee">-</span></div>
    <div class="summary-total">ยอดรวมทั้งหมด: <span id="sum-total">฿0</span></div>
  </div>
</div>

@end
