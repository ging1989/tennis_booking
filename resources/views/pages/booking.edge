@layouts.master({title: 'Book a court'})

<!-- Progress Stepper -->
<div class="booking-stepper">
  <div class="step active">
    <div class="step-circle">1</div>
    <div class="step-label">Time slot</div>
  </div>
  <div class="step-line"></div>
  <div class="step">
    <div class="step-circle">2</div>
    <div class="step-label">Details</div>
  </div>
  <div class="step-line"></div>
  <div class="step">
    <div class="step-circle">3</div>
    <div class="step-label">Payment</div>
  </div>
</div>

<!-- Main Layout -->
<div
  class="booking-layout"
  id="booking-page"
  data-court-name="{{ court ? court.courtName : '' }}"
  data-booked-slots='{{{ bookedSlotsJson || "[]" }}}'
>

  <!-- Left: Time Slot Selection -->
  <div class="booking-main">
    <h2>Select time slots</h2>
    <p class="booking-subtitle">Choose up to 3 consecutive slots</p>

    <!-- Court Info -->
    <div class="court-info-card">
      <div class="court-info-text">
        <div class="court-info-name">{{ court ? court.courtName : '' }}</div>
        <div class="court-info-detail">฿300/hr</div>
      </div>
    </div>

    <!-- Date -->
    <div class="booking-field">
      <label>Date</label>
      <input type="date" id="booking-date" value="{{ bookingDate || '' }}">
    </div>

    <!-- Court Select -->
    <div class="booking-field">
      <label>เลือกสนาม</label>
      <select class="ui dropdown" id="court-select">
        <option value="">เลือกสนาม</option>
        @each(c in courts)
          <option value="{{ c.id }}" {{ court && court.id === c.id ? 'selected' : '' }}>{{ c.courtName }}</option>
        @end
      </select>
    </div>

    <!-- Slot Status -->
    <div class="slot-status">Selected: <span id="selected-label">none</span> — Max 3 consecutive slots</div>

    <!-- Slot Grid -->
    <div id="slot-grid" class="slot-grid"></div>

    <!-- Continue Button -->
    <button class="continue-btn" id="continue-booking">Continue →</button>
  </div>

  <!-- Right: Booking Summary -->
  <div class="booking-summary">
    <h3>Booking summary</h3>
    <div class="summary-row"><span>Court</span><span id="sum-court">-</span></div>
    <div class="summary-row"><span>Date</span><span id="sum-date">-</span></div>
    <div class="summary-row"><span>Time</span><span id="sum-time">-</span></div>
    <div class="summary-row"><span>Duration</span><span id="sum-duration">-</span></div>
    <div class="summary-row"><span>Court fee</span><span id="sum-fee">-</span></div>
    <div class="summary-total">Total: <span id="sum-total">฿0</span></div>
  </div>

</div>

@end
